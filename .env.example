# Backend config -- copy to backend/.env (or project root .env) and fill in.

# AI CISO agent: required for genuine LLM-generated answers in the chat drawer.
# Without it, /api/v1/agent/query falls back to a rule-based templated response.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
